<% flash.each do |type, message| %>
  <% next unless message.is_a?(String) && message.present? %>
  <div class="alert alert-<%= type.to_s == "notice" ? "success" : "danger" %> alert-dismissible fade show" role="alert">
    <%= message %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% end %>
