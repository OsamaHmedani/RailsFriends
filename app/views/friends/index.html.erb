<% content_for :title, "Friend" %>
<% if user_signed_in? %>
<h1>Friend List</h1>

<table class="table 
table-striped
table-striped-columns
table-hover
table-bordered
border-primary">
  <thead class="thead-dark ">
    <tr>
      <th>Name</th>
      <th>Email</th>
      <th>Phone</th>
      <th>Twitter</th>
      <th></th>
    </tr>
  </thead>
  <tbody id="friends">
    <% @friends.each do |friend| %>
      <% if friend.user_id == current_user.id %>
      <tr id="<%= dom_id friend %>">
        <td>
        <%= link_to friend_path(friend) do %>
        <%= friend.first_name %>
        <%= friend.last_name %>
        <% end %></td>
        <td><%= friend.email %></td>
        <td><%= friend.phone %></td>
        <td><%= friend.twitter %></td>
        <td class="text-nowrap" style="width: 1%">
          <%= button_to "Destroy", friend, method: :delete,
          data: { turbo_confirm: "Are you sure?" },
           class: "btn btn-outline-danger btn-sm" %>
        </td>
      </tr>
      <% end %>
    <% end %>
  </tbody>
</table>

<%= link_to "New friend", new_friend_path, class:"btn btn-secondary"%>

<% else %>

<h1>Hello World!</h1>

This is my second rails web page actually!

<% end %>
