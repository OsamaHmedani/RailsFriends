<div class="p-5 mb-4 bg-secondary-subtle rounded-3">
  <h1 class="display-4">
    <%= @friend.first_name %>
    <%= @friend.last_name %>
  </h1>
  <p class="lead">
    <%= @friend.email %>
    <%= @friend.phone %>
    <%= @friend.twitter %>

  </p>
  <hr class="my-4">
  <p>
    
  </p>
  <div class="lead">
    <%= link_to "Edit this friend", edit_friend_path(@friend),class:"btn btn-secondary" %> 
  
    <%= link_to "Back to friends", friends_path,class:"btn btn-secondary" %>
  <%= button_to "Destroy this friend", @friend, method: :delete,
        class: "btn btn-secondary", form_class: "mt-3" %>
  </div>
</div>

